venv/
__pycache__/
*.pyc
.env

# pytest-cov generated coverage data
.coverage

# Claude Code local config and memory
.claude/

# Mac system file just in case
.DS_Store

# Database files - generated from user CSV uploads
data/*.db
# data/.gitkeep is intentionally tracked to preserve the empty folder

# Generated charts
# Ignore all files in the charts directory
data/charts/*
# But keep the .gitkeep file to preserve the empty charts directory
!data/charts/.gitkeep

# Uploaded files — generated from user file uploads
data/uploads/*
!data/uploads/.gitkeep

# SEC EDGAR lake (Phase 6) — generated locally by `python -m ingestion`;
# rebuildable from the SEC's published files, never checked in. Phase 7's silver
# and gold Delta tables are written under it too.
data/lake/

# Spark leftovers (Phase 7) — Spark creates these in whatever folder it is run
# from when it sets up its table catalog; never checked in
spark-warehouse/
metastore_db/
derby.log
